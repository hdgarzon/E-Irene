# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # solo server; tareas de sistema (audit, RPC admin)
NEXT_PUBLIC_APP_URL=                # dominio público, p.ej. https://e-irene.co (usado en links de paciente)

# ── Cifrado app-layer (AES-256-GCM) ───────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ── Proveedores externos (opcionales: activan modo "live") ─
#
# ⚠️ PENDIENTES EN PRODUCCIÓN (auditoría ago-2026)
#
# En el proyecto de Vercel SOLO están configuradas DEEPGRAM_API_KEY y
# OPENAI_API_KEY. Las demás de este bloque faltan, y su ausencia NO produce
# ningún error visible — cada proveedor degrada a un modo simulado:
#
#   RESEND_API_KEY / EMAIL_FROM  → ningún correo sale. Afecta recordatorios de
#     cita, enlaces de consentimiento y PHQ-9 al paciente, avisos de "reporte
#     listo", alertas de riesgo al doctor (incluida ideación suicida) y la
#     decisión de verificación profesional.
#   TWILIO_*                     → ningún WhatsApp sale.
#   DAILY_API_KEY                → las videollamadas usan salas falsas
#     (https://mock.video/...) a las que nadie se puede conectar.
#   NEXT_PUBLIC_SITE_URL         → enviar el recordatorio de una cita de VIDEO
#     lanza excepción (app/(app)/appointments/actions.ts).
#
# Desde la migración 0036 la app registra `notifications.status = 'simulated'`
# en vez de afirmar un envío, así que el problema es visible en datos — pero
# sigue sin enviar. Configurar y redesplegar para que tomen efecto.
#
DEEPGRAM_API_KEY=                   # vacío → transcripción en modo mock
OPENAI_API_KEY=                     # vacío → análisis IA en modo mock
RESEND_API_KEY=                     # vacío → email en modo log/mock
EMAIL_FROM=                         # remitente, p.ej. "E-Irene <citas@tudominio.co>"

# ── WhatsApp (Twilio) — opcional, planes Clínica/Enterprise ─
TWILIO_ACCOUNT_SID=                 # vacío → WhatsApp en modo log/mock
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=               # p.ej. "whatsapp:+14155238886"

# ── Telehealth (Daily.co) ─────────────────────────────────
DAILY_API_KEY=                      # vacío → videollamada en modo mock
VIDEO_PROVIDER=                     # forzado opcional: mock | daily
NEXT_PUBLIC_SITE_URL=               # p.ej. https://app.tudominio.co (para links de /join)

# Forzado opcional de proveedor (mock | deepgram | openai)
TRANSCRIPTION_PROVIDER=
ANALYSIS_PROVIDER=

# ── Facturación (Wompi) — Fase 1-3: webhook + checkout + cobro recurrente ──
# Secreto de EVENTOS del Dashboard de Wompi (no la llave de API) — firma la
# verificación de integridad de cada webhook. Vacío → el webhook rechaza
# todo con 503 (fail closed, no hay forma de verificar sin esto).
WOMPI_EVENTS_SECRET=
# Llave pública y privada de Wompi (Dashboard → Configuración). Se usan para
# crear el checkout de "mejorar plan" y los cobros recurrentes.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
# Ambiente de Wompi: sandbox | production. Default sandbox.
WOMPI_ENVIRONMENT=sandbox
# Secreto para proteger el endpoint de cobro recurrente (/api/cron/billing).
CRON_SECRET=
